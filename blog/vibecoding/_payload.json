[{"data":1,"prerenderedAt":370},["ShallowReactive",2],{"content-query-VcMiAXEqrt":3},{"_path":4,"_dir":5,"_draft":6,"_partial":6,"_locale":7,"title":8,"description":9,"date":10,"author":11,"body":12,"_type":364,"_id":365,"_source":366,"_file":367,"_stem":368,"_extension":369},"/blog/vibecoding","blog",false,"","Vibe Coding: Programando a base de 'buena vibra' y por qué hemos migrado a Antigravity","Descubre qué es el Vibe Coding y por qué hemos migrado nuestro blog a Antigravity para programar con agentes de IA.","2026-02-01","Jorge",{"type":13,"children":14,"toc":353},"root",[15,24,38,45,64,104,110,131,138,150,182,188,206,226,267,273,305,310,321],{"type":16,"tag":17,"props":18,"children":20},"element","h1",{"id":19},"vibe-coding-programando-a-base-de-buena-vibra-y-por-qué-hemos-migrado-a-antigravity",[21],{"type":22,"value":23},"text","Vibe Coding: Programando a base de \"buena vibra\" y por qué hemos migrado a Antigravity",{"type":16,"tag":25,"props":26,"children":27},"p",{},[28,30,36],{"type":22,"value":29},"¿Alguna vez has sentido que tienes la idea perfecta en la cabeza pero la sintaxis de un lenguaje o la configuración de un framework te frena? Bienvenido al ",{"type":16,"tag":31,"props":32,"children":33},"strong",{},[34],{"type":22,"value":35},"Vibe Coding",{"type":22,"value":37},", una tendencia que está cambiando la forma en la que construimos software y la razón principal por la que hemos decidido darle un giro radical a cómo gestionamos este blog.",{"type":16,"tag":39,"props":40,"children":42},"h2",{"id":41},"qué-es-eso-del-vibe-coding",[43],{"type":22,"value":44},"¿Qué es eso del \"Vibe Coding\"?",{"type":16,"tag":25,"props":46,"children":47},{},[48,50],{"type":22,"value":49},"El término, popularizado recientemente por Andrej Karpathy (ex-director de IA en Tesla y cofundador de OpenAI), describe un flujo de trabajo donde el programador deja de pelearse con el teclado línea por línea para convertirse en un \"director de orquesta\" de agentes de Inteligencia Artificial.",{"type":16,"tag":51,"props":52,"children":53},"sup",{},[54],{"type":16,"tag":55,"props":56,"children":61},"a",{"href":57,"ariaDescribedBy":58,"dataFootnoteRef":7,"id":60},"#user-content-fn-1",[59],"footnote-label","user-content-fnref-1",[62],{"type":22,"value":63},"1",{"type":16,"tag":25,"props":65,"children":66},{},[67,69,73,75,80,82,87,89,95,97,102],{"type":22,"value":68},"En el ",{"type":16,"tag":31,"props":70,"children":71},{},[72],{"type":22,"value":35},{"type":22,"value":74},", tú no escribes el código; tú dictas la intención. Mantienes la \"vibra\" del proyecto, defines el ",{"type":16,"tag":31,"props":76,"children":77},{},[78],{"type":22,"value":79},"qué",{"type":22,"value":81}," y el ",{"type":16,"tag":31,"props":83,"children":84},{},[85],{"type":22,"value":86},"para qué",{"type":22,"value":88},", mientras dejas que herramientas ",{"type":16,"tag":90,"props":91,"children":92},"em",{},[93],{"type":22,"value":94},"agentic",{"type":22,"value":96}," (como Cursor, Windsurf o la que hoy nos ocupa, Antigravity) se encarguen del ",{"type":16,"tag":31,"props":98,"children":99},{},[100],{"type":22,"value":101},"cómo",{"type":22,"value":103},". Es programar a nivel de concepto, confiando en que la IA entiende el contexto y la arquitectura global.",{"type":16,"tag":39,"props":105,"children":107},{"id":106},"la-gran-actualización-hola-antigravity",[108],{"type":22,"value":109},"La Gran Actualización: Hola, Antigravity",{"type":16,"tag":25,"props":111,"children":112},{},[113,115,122,124,129],{"type":22,"value":114},"Si has seguido el repositorio de ",{"type":16,"tag":116,"props":117,"children":119},"code",{"className":118},[],[120],{"type":22,"value":121},"freebot/OtroBlogCode",{"type":22,"value":123},", habrás notado cambios importantes. Hemos dejado atrás los sistemas de gestión pesados para abrazar ",{"type":16,"tag":31,"props":125,"children":126},{},[127],{"type":22,"value":128},"Antigravity",{"type":22,"value":130},".",{"type":16,"tag":132,"props":133,"children":135},"h3",{"id":134},"por-qué-antigravity",[136],{"type":22,"value":137},"¿Por qué Antigravity?",{"type":16,"tag":25,"props":139,"children":140},{},[141,143,148],{"type":22,"value":142},"Antigravity no es solo un editor; es el primer IDE ",{"type":16,"tag":90,"props":144,"children":145},{},[146],{"type":22,"value":147},"agent-first",{"type":22,"value":149},". Está diseñado para que la IA (específicamente Gemini) no sea un simple autocompletado, sino un agente con autonomía. Al actualizar el blog con esta tecnología, hemos logrado:",{"type":16,"tag":151,"props":152,"children":153},"ul",{},[154,172],{"type":16,"tag":155,"props":156,"children":157},"li",{},[158,163,165,170],{"type":16,"tag":31,"props":159,"children":160},{},[161],{"type":22,"value":162},"Iteración ultra-rápida",{"type":22,"value":164},": Si quiero cambiar el diseño de las tarjetas del blog, ya no busco el archivo CSS. Le digo al agente: ",{"type":16,"tag":90,"props":166,"children":167},{},[168],{"type":22,"value":169},"\"Dale un aire más minimalista y asegúrate de que el contraste sea accesible\"",{"type":22,"value":171},". Y sucede.",{"type":16,"tag":155,"props":173,"children":174},{},[175,180],{"type":16,"tag":31,"props":176,"children":177},{},[178],{"type":22,"value":179},"Reducción de la fricción",{"type":22,"value":181},": Antigravity elimina la necesidad de gestionar manualmente cada dependencia o configuración de despliegue.",{"type":16,"tag":39,"props":183,"children":185},{"id":184},"por-qué-markdown-es-la-pieza-clave",[186],{"type":22,"value":187},"¿Por qué Markdown es la pieza clave?",{"type":16,"tag":25,"props":189,"children":190},{},[191,193,198,200,205],{"type":22,"value":192},"Muchos se preguntarán: ",{"type":16,"tag":90,"props":194,"children":195},{},[196],{"type":22,"value":197},"\"Si usas agentes tan avanzados, ¿por qué volver a Markdown?\"",{"type":22,"value":199},". La respuesta es sencilla: Markdown es la ",{"type":16,"tag":31,"props":201,"children":202},{},[203],{"type":22,"value":204},"memoria de trabajo perfecta para la IA",{"type":22,"value":130},{"type":16,"tag":25,"props":207,"children":208},{},[209,211,217,219,224],{"type":22,"value":210},"En el ecosistema de Antigravity, los archivos ",{"type":16,"tag":116,"props":212,"children":214},{"className":213},[],[215],{"type":22,"value":216},".md",{"type":22,"value":218}," no son solo texto plano para humanos; funcionan como ",{"type":16,"tag":31,"props":220,"children":221},{},[222],{"type":22,"value":223},"planos de ejecución para los agentes",{"type":22,"value":225},". Al usar Markdown:",{"type":16,"tag":151,"props":227,"children":228},{},[229,247,257],{"type":16,"tag":155,"props":230,"children":231},{},[232,237,239,245],{"type":16,"tag":31,"props":233,"children":234},{},[235],{"type":22,"value":236},"Contexto persistente",{"type":22,"value":238},": Los archivos ",{"type":16,"tag":116,"props":240,"children":242},{"className":241},[],[243],{"type":22,"value":244},"task_plan.md",{"type":22,"value":246}," permiten que el agente sepa exactamente en qué fase del desarrollo estamos, qué errores hemos corregido y cuál es el siguiente paso.",{"type":16,"tag":155,"props":248,"children":249},{},[250,255],{"type":16,"tag":31,"props":251,"children":252},{},[253],{"type":22,"value":254},"Transparencia",{"type":22,"value":256},": Tú, como humano, puedes leer el \"pensamiento\" del agente y ajustar la dirección (la vibra) simplemente editando una línea de texto.",{"type":16,"tag":155,"props":258,"children":259},{},[260,265],{"type":16,"tag":31,"props":261,"children":262},{},[263],{"type":22,"value":264},"Portabilidad",{"type":22,"value":266},": El blog sigue siendo ligero, versionable en Git y fácil de leer para cualquiera, pero con la potencia de una IA que \"entiende\" cada encabezado y cada bloque de código.",{"type":16,"tag":39,"props":268,"children":270},{"id":269},"conclusión",[271],{"type":22,"value":272},"Conclusión",{"type":16,"tag":25,"props":274,"children":275},{},[276,278,284,286,290,292,296,298,303],{"type":22,"value":277},"Actualizar ",{"type":16,"tag":116,"props":279,"children":281},{"className":280},[],[282],{"type":22,"value":283},"OtroBlogCode",{"type":22,"value":285}," no ha sido solo un cambio de herramientas, sino un cambio de filosofía. El ",{"type":16,"tag":31,"props":287,"children":288},{},[289],{"type":22,"value":35},{"type":22,"value":291}," nos permite centrarnos en lo que realmente importa: el contenido y la creatividad, dejando que ",{"type":16,"tag":31,"props":293,"children":294},{},[295],{"type":22,"value":128},{"type":22,"value":297}," y ",{"type":16,"tag":31,"props":299,"children":300},{},[301],{"type":22,"value":302},"Markdown",{"type":22,"value":304}," se encarguen de la \"gravedad\" del desarrollo técnico.",{"type":16,"tag":25,"props":306,"children":307},{},[308],{"type":22,"value":309},"Si quieres ver cómo se siente programar sin tocar apenas el código, date una vuelta por el repo y echa un ojo a los nuevos archivos de planificación. ¡La vibra nunca ha sido tan buena!",{"type":16,"tag":25,"props":311,"children":312},{},[313,315,319],{"type":22,"value":314},"Publicado en ",{"type":16,"tag":31,"props":316,"children":317},{},[318],{"type":22,"value":283},{"type":22,"value":320}," – Donde el código fluye y la IA se encarga del resto.",{"type":16,"tag":322,"props":323,"children":326},"section",{"className":324,"dataFootnotes":7},[325],"footnotes",[327,334],{"type":16,"tag":39,"props":328,"children":331},{"className":329,"id":59},[330],"sr-only",[332],{"type":22,"value":333},"Footnotes",{"type":16,"tag":335,"props":336,"children":337},"ol",{},[338],{"type":16,"tag":155,"props":339,"children":341},{"id":340},"user-content-fn-1",[342,344],{"type":22,"value":343},"Andrej Karpathy, ex-director de IA en Tesla y cofundador de OpenAI. ",{"type":16,"tag":55,"props":345,"children":350},{"href":346,"ariaLabel":347,"className":348,"dataFootnoteBackref":7},"#user-content-fnref-1","Back to reference 1",[349],"data-footnote-backref",[351],{"type":22,"value":352},"↩",{"title":7,"searchDepth":354,"depth":354,"links":355},2,[356,357,361,362,363],{"id":41,"depth":354,"text":44},{"id":106,"depth":354,"text":109,"children":358},[359],{"id":134,"depth":360,"text":137},3,{"id":184,"depth":354,"text":187},{"id":269,"depth":354,"text":272},{"id":59,"depth":354,"text":333},"markdown","content:blog:Vibecoding.md","content","blog/Vibecoding.md","blog/Vibecoding","md",1770266335961]